<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_screen"
    tools:context=".WelcomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/welcomeMainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp">

        <!-- Top Hero Banner -->
        <LinearLayout
            android:id="@+id/heroBannerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/primary_emerald"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- FrameLayout Logo Badge -->
            <FrameLayout
                android:id="@+id/flLogoContainer"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@color/accent_gold"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/ivAppLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/primary_emerald_dark"
                    android:contentDescription="@string/cd_devfolio_logo"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/text_on_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.05"
                android:text="@string/welcome_app_name"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudentNameHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/student_name"
                android:textColor="@color/text_on_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudentProgram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/student_program"
                android:textColor="@color/primary_emerald_light"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Welcome Description Card -->
        <LinearLayout
            android:id="@+id/cardWelcomeDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroBannerLayout">

            <TextView
                android:id="@+id/tvWelcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcomeBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/welcome_bio"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Highlighted Specialization Pill Row -->
            <LinearLayout
                android:id="@+id/llTechHighlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tvBadgeAndroid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@color/primary_emerald_light"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/badge_android_sdk"
                    android:textColor="@color/primary_emerald"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeKotlinJava"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@color/accent_gold_light"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/badge_kotlin_java"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeArchitecture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/primary_emerald_light"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/badge_systems_qa"
                    android:textColor="@color/primary_emerald"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Featured Project Spotlight Box -->
        <LinearLayout
            android:id="@+id/cardSpotlightProject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@color/bg_subtle_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardWelcomeDescription">

            <ImageView
                android:id="@+id/ivSpotlightIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_spotlight_icon"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/primary_emerald" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSpotlightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spotlight_label"
                    android:textColor="@color/secondary_teal"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpotlightTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/spotlight_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons Section (Future Module 7 Explicit Intents) -->
        <LinearLayout
            android:id="@+id/llWelcomeActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSpotlightProject">

            <Button
                android:id="@+id/btnExploreDashboard"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="@color/primary_emerald"
                android:text="@string/btn_explore_dashboard"
                android:textColor="@color/text_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenInquiryForm"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/secondary_teal"
                android:text="@string/btn_open_inquiry_form"
                android:textColor="@color/text_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickContact"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/accent_gold"
                android:text="@string/btn_quick_contact"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>