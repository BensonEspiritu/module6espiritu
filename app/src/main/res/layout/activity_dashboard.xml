<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboardScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true"
    tools:context=".DashboardActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dashboardConstraintRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp">

        <!-- Dashboard Header -->
        <LinearLayout
            android:id="@+id/llDashboardHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/primary_emerald"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivDashboardAvatar"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@color/accent_gold"
                android:contentDescription="@string/cd_profile_icon"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/primary_emerald_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDashboardHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_heading"
                    android:textColor="@color/text_on_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDashboardSubheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dashboard_subheading"
                    android:textColor="@color/primary_emerald_light"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Engineering Metrics Summary in TableLayout -->
        <TableLayout
            android:id="@+id/tlPortfolioMetrics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/bg_card"
            android:elevation="2dp"
            android:padding="14dp"
            android:stretchColumns="0,1,2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llDashboardHeader">

            <TableRow android:id="@+id/trMetricsValues">
                <TextView
                    android:id="@+id/tvMetricProjectsCount"
                    android:gravity="center"
                    android:text="@string/metric_projects_count"
                    android:textColor="@color/primary_emerald"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMetricLanguagesCount"
                    android:gravity="center"
                    android:text="@string/metric_languages_count"
                    android:textColor="@color/secondary_teal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMetricSpecialization"
                    android:gravity="center"
                    android:text="@string/metric_specialization"
                    android:textColor="@color/accent_gold"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow
                android:id="@+id/trMetricsLabels"
                android:layout_marginTop="4dp">
                <TextView
                    android:gravity="center"
                    android:text="@string/metric_label_core_systems"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:gravity="center"
                    android:text="@string/metric_label_languages"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:gravity="center"
                    android:text="@string/metric_label_track"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </TableRow>
        </TableLayout>

        <!-- Portfolio Feature Modules (Cards + Menu Buttons) -->
        <LinearLayout
            android:id="@+id/llDashboardMenuCards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tlPortfolioMetrics">

            <TextView
                android:id="@+id/tvMenuSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/menu_section_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Menu Option 1: Project Architecture & Details -->
            <LinearLayout
                android:id="@+id/cardMenuProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMenuIconProjects"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/cd_projects_icon"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="@color/primary_emerald" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardProjectsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_projects_title"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardProjectsDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/card_projects_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnMenuCaseStudy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/primary_emerald"
                    android:text="@string/btn_menu_case_study"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Menu Option 2: Recruiter / Collaborator Registration Form -->
            <LinearLayout
                android:id="@+id/cardMenuRegistration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMenuIconRegistration"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/cd_registration_icon"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/secondary_teal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardRegistrationTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_registration_title"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardRegistrationDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/card_registration_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnMenuRegisterInquiry"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/secondary_teal"
                    android:text="@string/btn_menu_register_inquiry"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Menu Option 3: Contact, Share & External Actions -->
            <LinearLayout
                android:id="@+id/cardMenuContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMenuIconContact"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/cd_contact_share_icon"
                        android:src="@android:drawable/ic_menu_share"
                        app:tint="@color/accent_gold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardContactTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/card_contact_title"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardContactDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/card_contact_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnMenuContactShare"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/accent_gold"
                    android:text="@string/btn_menu_contact_share"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Menu Option 4: Return to Welcome Screen -->
            <Button
                android:id="@+id/btnMenuBackWelcome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/text_muted"
                android:text="@string/btn_menu_back_welcome"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>