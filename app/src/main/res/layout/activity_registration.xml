<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registrationScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true"
    tools:context=".RegistrationActivity">

    <LinearLayout
        android:id="@+id/llRegistrationMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Screen Header -->
        <LinearLayout
            android:id="@+id/llRegistrationHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_emerald"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivRegistrationHeaderIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/cd_registration_form_icon"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/accent_gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFormHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_header_title"
                    android:textColor="@color/text_on_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFormInstructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/form_instructions"
                    android:textColor="@color/primary_emerald_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Form Card Container -->
        <LinearLayout
            android:id="@+id/llFormCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Section 1: Visitor Identity (EditTexts 1, 2, 3) -->
            <TextView
                android:id="@+id/tvSectionIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_identity"
                android:textColor="@color/primary_emerald"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLabelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_name"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etVisitorName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:autofillHints="name"
                android:background="@color/bg_subtle_panel"
                android:hint="@string/hint_visitor_name"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLabelEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_email"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etVisitorEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:autofillHints="emailAddress"
                android:background="@color/bg_subtle_panel"
                android:hint="@string/hint_visitor_email"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLabelOrganization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_organization"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOrganization"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:autofillHints="organizationName"
                android:background="@color/bg_subtle_panel"
                android:hint="@string/hint_organization"
                android:inputType="textCapWords"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <!-- Section 2: Additional Controls (RadioButton, Spinner, CheckBox, Switch) -->
            <TextView
                android:id="@+id/tvSectionParameters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_parameters"
                android:textColor="@color/primary_emerald"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLabelInquiryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/label_inquiry_type"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgInquiryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbInternshipOffer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/rb_internship_offer"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbCapstoneCollab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rb_capstone_collab"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbFreelanceBuild"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rb_freelance_build"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvLabelTechDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_tech_domain"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spProjectDomain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/bg_subtle_panel"
                android:entries="@array/tech_domains_array"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/tvLabelDeliverables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_deliverables"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbRequestResume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/cb_request_resume"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbSourceCodeAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cb_source_code_access"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbScheduleInterview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cb_schedule_interview"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/swUrgentPriority"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="@string/sw_urgent_priority"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <!-- EditText 4: Project Brief / Notes -->
            <TextView
                android:id="@+id/tvLabelProjectNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_project_notes"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProjectNotes"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="4dp"
                android:background="@color/bg_subtle_panel"
                android:gravity="top|start"
                android:hint="@string/hint_project_notes"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <!-- Action Buttons inside RelativeLayout (Clear/Reset & Submit/Continue) -->
            <RelativeLayout
                android:id="@+id/rlFormButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnClearForm"
                    android:layout_width="130dp"
                    android:layout_height="52dp"
                    android:layout_alignParentStart="true"
                    android:backgroundTint="@color/text_muted"
                    android:text="@string/btn_clear_form"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSubmitRegistration"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/btnClearForm"
                    android:backgroundTint="@color/primary_emerald"
                    android:text="@string/btn_submit_registration"
                    android:textColor="@color/text_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>